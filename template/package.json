{
  "name": "__APP_SLUG__",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run --passWithNoTests src/lib",
    "typecheck": "tsc --noEmit",
    "preflight": "bash $HOME/Desktop/app-factory/scripts/preflight.sh .",
    "spec": "node $HOME/Desktop/app-factory/scripts/spec-lint.mjs docs/spec.json",
    "icons": "node $HOME/Desktop/app-factory/scripts/icons.mjs .",
    "shots": "node $HOME/Desktop/app-factory/scripts/shots.mjs . --check",
    "asc": "node $HOME/Desktop/app-factory/scripts/asc.mjs",
    "aso": "node $HOME/Desktop/app-factory/scripts/aso-lint.mjs store",
    "check": "npm run typecheck && npm run test && npm run preflight"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.5",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
