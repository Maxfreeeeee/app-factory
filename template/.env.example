# Copy to .env and fill. Everything with EXPO_PUBLIC_ ships inside the app
# bundle and is readable by anyone who downloads it — only put values here that
# are safe in public. Server secrets belong in supabase/functions/.env.
# URL looks like https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
